{
  "experiments": {
    "factorybot_buchi_reward_tradeoff": {
      "description": "FactoryBot matched-reward shielding quality, based on the paper's Figure 4b/Figure 5 visual estimates at the epsilon=0.4 reward-gap operating point. The paper reports the proposed shield achieving much higher Buchi frequency than the naive exploratory shield while staying within the same reward-closeness condition.",
      "weight": 1.0,
      "primary_metric": "buchi_frequency",
      "metrics": {
        "buchi_frequency": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "reward_gap_to_nominal": {
          "higher_is_better": false,
          "coefficient": -0.5
        },
        "buchi_frequency_gain_over_naive": {
          "higher_is_better": true,
          "coefficient": 0.8
        }
      },
      "results": {
        "unshielded": {
          "type": "baseline",
          "buchi_frequency": 0.015,
          "reward_gap_to_nominal": 0.0,
          "buchi_frequency_gain_over_naive": -0.018
        },
        "apply_naive": {
          "type": "baseline",
          "buchi_frequency": 0.033,
          "reward_gap_to_nominal": 0.4,
          "buchi_frequency_gain_over_naive": 0.0
        },
        "apply_stars": {
          "type": "proposed",
          "buchi_frequency": 0.12,
          "reward_gap_to_nominal": 0.4,
          "buchi_frequency_gain_over_naive": 0.087
        }
      }
    }
  }
}
