{
  "experiments": {
    "factorybot_buchi_reward_tradeoff": {
      "description": "FactoryBot matched-reward shielding quality, based on the paper's Figure 4b visual estimates at the 0.5 reward-closeness threshold. The paper reports the proposed shield achieving much higher Buchi frequency than the naive exploratory shield while staying within the same reward-closeness condition.",
      "weight": 1.0,
      "primary_metric": "buchi_frequency",
      "metrics": {
        "buchi_frequency": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "average_reward": {
          "higher_is_better": true,
          "coefficient": 0.4
        },
        "mean_tv_interference": {
          "higher_is_better": false,
          "coefficient": -0.2
        },
        "override_rate": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "buchi_frequency_gain_over_naive": {
          "higher_is_better": true,
          "coefficient": 0.8
        }
      },
      "results": {
        "unshielded": {
          "type": "baseline",
          "buchi_frequency": 0.015,
          "average_reward": 1.0,
          "mean_tv_interference": 0.0,
          "override_rate": 0.0,
          "buchi_frequency_gain_over_naive": 0.0
        },
        "apply_naive": {
          "type": "baseline",
          "buchi_frequency": 0.015,
          "average_reward": 1.0,
          "mean_tv_interference": 0.5,
          "override_rate": 0.5,
          "buchi_frequency_gain_over_naive": 0.0
        },
        "apply_stars": {
          "type": "proposed",
          "buchi_frequency": 0.24,
          "average_reward": 1.0,
          "mean_tv_interference": 0.5,
          "override_rate": 0.5,
          "buchi_frequency_gain_over_naive": 0.225
        }
      }
    }
  }
}
